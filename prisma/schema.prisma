// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id             String         @id
  name           String
  email          String         @unique
  image          Media?
  emailVerified  Boolean        @default(false)
  phoneNumber    String?
  provider       String?
  lastLogin      DateTime?
  role           Role           @default(USER)
  cartItems      CartItems[]
  merchant       Merchant?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  addresses      Address[]
  orders         Order[]
  pointHistories PointHistory[]
  carts          Carts?
  userDevices    UserDevices[]
}

enum Role {
  USER
  MERCHANT
  ADMIN
}

model UserDevices {
  id         String  @id @default(uuid())
  userId     String
  user       Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken   String  @unique
  deviceType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Merchant {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  logoUrl     Media?
  ownerId     String     @unique
  owner       Users      @relation(fields: [ownerId], references: [id])
  address     Address?
  products    Products[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Products {
  id          String           @id @default(uuid())
  title       String
  description String?
  images      Media[]
  merchantId  String
  merchant    Merchant         @relation(fields: [merchantId], references: [id])
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id          String       @id @default(uuid())
  productId   String
  product     Products     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName String // เช่น "สีแดง, ไซส์ L"
  price       Float // ราคาของรูปแบบนี้
  stock       Int          @default(0) // <--- หัวใจของสต็อกอยู่ที่นี่
  images      Media[] // รูปเฉพาะของสีนั้นๆ
  sku         String?      @unique
  cartItems   CartItems[]
  orderItems  OrderItems[] // เปลี่ยน OrderItems มาผูกที่นี่แทน
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Media {
  id         String          @id @default(uuid())
  url        String // ลิงก์ที่ได้จาก Firebase Storage
  path       String // storage path (เอาไว้ใช้ตอนสั่งลบไฟล์ใน firebase)
  fileName   String?
  mimeType   String? // image/jpeg, image/png
  size       Int? // ขนาดไฟล์ (bytes)
  createdAt  DateTime        @default(now())
  // --- Relations ---
  // เชื่อมกับ User (เช่น รูป Profile)
  userId     String?         @unique
  user       Users?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // เชื่อมกับ Merchant (เช่น โลโก้ร้าน)
  merchantId String?         @unique
  merchant   Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // เชื่อมกับ Product (1 สินค้า มีได้หลายรูป)
  productId  String?
  product    Products?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  // เชื่อมกับ Variant (1 variant มีรูปเฉพาะของตัวเองได้)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, merchantId, userId])
}

model Carts {
  id         String      @id @default(uuid())
  userId     String      @unique
  user       Users       @relation(fields: [userId], references: [id])
  items      CartItems[]
  totalPrice Float       @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model CartItems {
  id        String         @id @default(uuid())
  userId    String
  user      Users          @relation(fields: [userId], references: [id])
  productId String
  products  ProductVariant @relation(fields: [productId], references: [id])
  quantity  Int            @default(1)
  carts     Carts?         @relation(fields: [cartsId], references: [id])
  cartsId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartsId, productId])
}

// --- 1. Category Table ---
model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  products  Products[]
  createdAt DateTime   @default(now())
}

// --- 2. Address Table (รองรับทั้ง User และ Merchant) ---
model Address {
  id           String    @id @default(uuid())
  receiverName String?
  phone        String?
  detail       String // บ้านเลขที่, ถนน
  subDistrict  String
  district     String
  province     String
  postcode     String
  isDefault    Boolean   @default(false)
  // Relation ไปยัง User (ที่อยู่จัดส่ง)
  userId       String?
  user         Users?    @relation(fields: [userId], references: [id])
  // Relation ไปยัง Merchant (ที่อยู่ร้านค้า)
  merchantId   String?   @unique
  merchant     Merchant? @relation(fields: [merchantId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, merchantId])
}

// --- 3. Order & OrderItems (หัวใจของการ Checkout) ---
model Order {
  id              String      @id @default(uuid())
  chargeId        String?
  userId          String
  user            Users       @relation(fields: [userId], references: [id])
  totalPrice      Float       @default(0)
  status          OrderStatus @default(PENDING)
  invoice         Invoice?
  shippingAddress String // เช่น "บ้านเลขที่... เขต... แขวง..."
  receiverName    String // ชื่อผู้รับสินค้า
  receiverPhone   String // เบอร์ติดต่อ
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expiredAt       DateTime
  receipt         Receipt?
  subOrders       SubOrder[]
}

model SubOrder {
  id           String         @id @default(uuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  merchantId   String
  merchantName String?
  shippingFee  Float          @default(0)
  totalPrice   Float          @default(0)
  status       SubOrderStatus @default(PENDING)
  createAt     DateTime       @default(now())
  updateAt     DateTime       @updatedAt
  orderItems   OrderItems[]
}

model OrderItems {
  id               String          @id @default(uuid())
  subOrderId       String
  subOrder         SubOrder        @relation(fields: [subOrderId], references: [id])
  productId        String
  merchantId       String
  title            String // Snapshot ชื่อสินค้า
  price            Float // Snapshot ราคา ณ วันที่ซื้อ
  quantity         Int
  image            String? // Snapshot รูสินค้า
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productVariantId String?

  @@unique([subOrderId, productVariantId])
}

// --- 4. Payment & Invoice ---
model Invoice {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Float
  paymentMethod String? // เช่น "QR_PROMPTPAY", "CREDIT_CARD"
  status        PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  receipt       Receipt?
}

model Receipt {
  id        String  @id @default(uuid())
  orderId   String  @unique
  order     Order   @relation(fields: [orderId], references: [id])
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  receiptNumber String   @unique // เช่น REC20240001
  amount        Float // ยอดที่จ่ายจริง
  paymentMethod String // เช่น "PROMPTPAY"
  omiseChargeId String? // เก็บ ID จาก Omise ไว้ตรวจสอบ
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())
}

// --- 5. Points System ---
model PointHistory {
  id        String   @id @default(uuid())
  amount    Int // แต้มที่ได้รับ (+) หรือใช้ไป (-)
  type      String // "EARNED", "REDEEMED"
  reason    String? // เช่น "Order #123"
  userId    String   @unique
  user      Users    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// --- Enums สำหรับสถานะต่างๆ ---
enum OrderStatus {
  PENDING // ลูกค้ากดสั่งซื้อแล้ว (รอชำระเงิน)
  PAID // ชำระเงินสำเร็จ (รอกระจายงานให้ร้านค้า)
  CANCELLED // ยกเลิกโดยลูกค้า หรือหมดเวลาชำระเงิน
  COMPLETED // ทุก SubOrder ส่งถึงมือลูกค้าเรียบร้อยแล้ว
}

enum SubOrderStatus {
  PENDING //รอการชำระเงิน
  PREPARING // ร้านค้าได้รับออเดอร์และกำลังแพ็คของ
  SHIPPED // ร้านค้าส่งของให้ขนส่งแล้ว
  DELIVERED // สินค้าจากร้านนี้ถึงมือลูกค้าแล้ว
  CANCELLED // ร้านค้ากดยกเลิก (เช่น สินค้าหมด)
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}
